# Exemple de variables d'environnement pour Terraform
# Copie en .env.local ou passe-les avec -var

# Développement
export TF_VAR_environment=dev
export TF_VAR_image_repo=filevault
export TF_VAR_image_tag=latest
export TF_VAR_db_password=dev-password-123
export TF_VAR_domain=filevault.local

# Production (décommenter si nécessaire)
# export TF_VAR_environment=prod
# export TF_VAR_image_repo=your-registry/filevault
# export TF_VAR_image_tag=v1.0.0
# export TF_VAR_domain=filevault.example.com
# export TF_VAR_db_password=$(openssl rand -base64 32)
